FROM php:8.2-apache

RUN docker-php-ext-install pdo_mysql mysqli

RUN sed -i 's/DirectoryIndex .*/DirectoryIndex index.php index.html/' /etc/apache2/mods-available/dir.conf

WORKDIR /var/www/html

COPY . /var/www/html/

RUN chown -R www-data:www-data /var/www/html

CMD ["sh", "-c", "port=$PORT; if [ -z \"$port\" ]; then port=80; fi; sed -i \"s/^Listen 80$/Listen $port/\" /etc/apache2/ports.conf; sed -i \"s#<VirtualHost .*:80>#<VirtualHost *:$port>#\" /etc/apache2/sites-available/000-default.conf; exec apache2-foreground"]